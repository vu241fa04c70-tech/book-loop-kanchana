# BookLoop Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookloop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bookloop

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary Storage (Optional for production image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
