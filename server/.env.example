# ========================================================
# BOOKLOOP BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Server Port and Environment
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Connection URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookloop?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random
JWT_EXPIRE=30d

# Frontend Client Origin (for CORS and reset links)
CLIENT_URL=https://bookloop.vercel.app

# Optional: Cloudinary Storage for Permanent Image Uploads
# (If omitted, BookLoop safely stores images in local /uploads directory)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: SMTP Email Dispatch for Notifications & Password Reset
# (If omitted, BookLoop safely logs emails to console in development mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@bookloop.org
SMTP_PASS=your_email_app_password
SMTP_FROM=no-reply@bookloop.org
